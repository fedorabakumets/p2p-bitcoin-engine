# Copy to .env and fill BOT_TOKEN when BotFather gives it to you.
# Do not commit .env. This file has no secrets.

BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://p2p:p2p@localhost:5432/p2p
REDIS_URL=redis://localhost:6379/0
BTC_RUB_RATE=6000000

# fake keeps virtual admin credits and does not call Bitcoin.
# electrum talks to a testnet Electrum daemon you start yourself.
# mainnet is refused. Do not put an RPC password in git.
WALLET_BACKEND=fake
BITCOIN_NETWORK=testnet
WALLET_MIN_CONFIRMATIONS=1
ELECTRUM_RPC_HOST=
ELECTRUM_RPC_PORT=
ELECTRUM_RPC_USER=
ELECTRUM_RPC_PASSWORD=
